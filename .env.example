# ==============================================================================
# Promptfoo Evaluation Suite Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Default Provider: Google Gemini
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GOOGLE_API_KEY="your-gemini-api-key-here"

# Alternative environment variable name recognized by promptfoo for Google GenAI:
# GOOGLE_GENAI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 2. Multi-Provider Alternates (Optional - Uncomment as needed)
# ------------------------------------------------------------------------------

# Groq (Ultra-fast inference for Llama 3.3, Mixtral, Gemma 2):
# GROQ_API_KEY="gsk_..."

# OpenRouter (Unified API for Claude 3.5, GPT-4o, DeepSeek, etc.):
# OPENROUTER_API_KEY="sk-or-v1-..."

# Anthropic Claude:
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI:
# OPENAI_API_KEY="sk-..."

# ------------------------------------------------------------------------------
# 3. Local Models (Ollama / vLLM / LocalAI)
# ------------------------------------------------------------------------------
# Ollama default base URL (no key required for local runner)
OLLAMA_BASE_URL="http://localhost:11434"

# vLLM or local OpenAI-compatible endpoint
# OPENAI_BASE_URL="http://localhost:8000/v1"

# ------------------------------------------------------------------------------
# 4. Promptfoo CLI & Runtime Configuration
# ------------------------------------------------------------------------------
# Disable anonymous telemetry
PROMPTFOO_DISABLE_TELEMETRY=true

# Disable automatic CLI update notices
PROMPTFOO_DISABLE_UPDATE_CHECK=true

# Enable disk caching of model calls to avoid redundant API spends during dev
PROMPTFOO_CACHE_ENABLED=true

# Automatically retry HTTP 5xx errors (such as transient Google 503 high demand spikes)
PROMPTFOO_RETRY_5XX=true

# Custom web UI port for `promptfoo view`
PROMPTFOO_PORT=15500
